# Copy to .env and fill in. Never commit .env.

# --- Models ---
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- News database (extraction + posting pipelines) ---
# e.g. DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase
DATABASE_URL=

# --- Mastra internal storage (optional; defaults to file:./mastra.db) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Telegram human review ---
# Talk to @BotFather to create a bot; its token goes here.
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the reviewer/group that receives preview cards.
# (Send any message to the bot, then GET
#  https://api.telegram.org/bot<TOKEN>/getUpdates to read the chat id.)
TELEGRAM_REVIEW_CHAT_ID=
# Minutes the posting workflow waits for approve/reject before timing out
# an article as skipped. Default 60 when unset.
TELEGRAM_APPROVAL_TIMEOUT_MINUTES=60
# Shared secret for POST /webhooks/telegram. Register it with Telegram:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url="https://<public-host>/webhooks/telegram" \
#     -d secret_token="<same value>"
# Requires a public HTTPS endpoint (deploy, or tunnel locally e.g. cloudflared).
# While the webhook is active, do NOT run getUpdates polling anywhere.
TELEGRAM_WEBHOOK_SECRET=

# --- X posting (OAuth 1.0a user context via twitter-api-v2) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
